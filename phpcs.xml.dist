<?xml version="1.0"?>
<ruleset name="SymPress Starter">
    <description>Shared SymPress standard for the theme's PHP adapters and unit tests.</description>
    <file>src</file>
    <file>tests/Unit</file>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="SymPress-Pure">
      <!-- Match twig-bundle's allowances for framework signatures, translations and fixtures. -->
      <exclude name="SlevomatCodingStandard.Functions.UnusedParameter.UnusedParameter"/>
      <exclude name="SymPress.Files.LineLength.TooLong"/>
      <exclude name="SymPress.Functions.FunctionLength.TooLong"/>
    </rule>
</ruleset>
