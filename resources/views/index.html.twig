{% extends '@theme/layouts/base.html.twig' %}
{% block content %}
  <header class="page-intro">
    <p class="eyebrow">{{ __('Journal') }}</p>
    <h1>{{ title }}</h1>
    {% if description %}<div class="intro-copy">{{ description }}</div>{% endif %}
  </header>
  {% if posts|length %}
    <div class="post-grid">
      {% for post in posts %}{% include '@theme/partials/post-summary.html.twig' %}{% endfor %}
    </div>
    {% include '@theme/partials/pagination.html.twig' %}
  {% else %}
    <div class="empty-state"><h2>{{ __('Hier ist noch Platz für Neues.') }}</h2><p>{{ __('Sobald Beiträge veröffentlicht werden, findest du sie hier.') }}</p></div>
  {% endif %}
{% endblock %}
