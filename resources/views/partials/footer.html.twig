<footer class="site-footer shell">
  <a class="wordmark" href="{{ site.url }}">{{ site.name }}</a>
  {% set footer_menu = menu('footer', {depth: 1}) %}
  {% if footer_menu.items %}<nav class="site-nav" aria-label="{{ __('Footernavigation') }}">{% include '@theme/partials/menu.html.twig' with {items: footer_menu.items} %}</nav>{% endif %}
  <p>© {{ 'now'|date('Y') }} {{ site.name }}</p>
  <a href="#content">{{ __('Nach oben') }} <span aria-hidden="true">↑</span></a>
</footer>
