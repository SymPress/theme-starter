<ul>
  {% for item in items %}
    <li class="{{ item.classes|join(' ') }}">
      <a href="{{ item.link }}"{% if item.current %} aria-current="page"{% endif %}{% if item.target %} target="{{ item.target }}"{% endif %}{% if item.rel %} rel="{{ item.rel }}"{% endif %}>{{ item.title }}</a>
      {% if item.children %}{% include '@theme/partials/menu.html.twig' with {items: item.children} %}{% endif %}
    </li>
  {% endfor %}
</ul>
