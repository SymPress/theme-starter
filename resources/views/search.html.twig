{% extends '@theme/layouts/base.html.twig' %}
{% block content %}
  <header class="page-intro"><p class="eyebrow">{{ __('Suche') }}</p><h1>{{ sprintf(__('Suche nach „%s“'), search_query) }}</h1></header>
  <div class="max-w-xl mb-12">{% include '@theme/partials/search-form.html.twig' %}</div>
  {% if posts|length %}
    <div class="post-grid">{% for post in posts %}{% include '@theme/partials/post-summary.html.twig' %}{% endfor %}</div>
    {% include '@theme/partials/pagination.html.twig' %}
  {% else %}
    <div class="empty-state"><h2>{{ __('Keine passenden Beiträge gefunden.') }}</h2><p>{{ __('Versuche einen anderen Suchbegriff oder kehre zur Startseite zurück.') }}</p><a class="text-link" href="{{ site.url }}">{{ __('Zur Startseite') }} <span aria-hidden="true">↗</span></a></div>
  {% endif %}
{% endblock %}
