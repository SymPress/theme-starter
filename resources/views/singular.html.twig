{% extends '@theme/layouts/base.html.twig' %}
{% block content %}
  {% for post in posts %}
    <article class="entry" id="post-{{ post.id }}">
      <header>
        {% if post.type == 'post' %}{% include '@theme/partials/post-meta.html.twig' %}{% endif %}
        <h1>{{ post.title }}</h1>
        {% if post.thumbnail('large', {class: 'featured-image'}) %}<div class="mb-8">{{ post.thumbnail('large', {class: 'featured-image'}) }}</div>{% endif %}
      </header>
      <div class="entry-content">{{ post.content }}</div>
      {{ wp_link_pages() }}
      {% if show_comments %}{{ comments_template() }}{% endif %}
    </article>
  {% endfor %}
{% endblock %}
