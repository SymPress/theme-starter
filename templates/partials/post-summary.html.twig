<article class="post-summary">
  {% if post.image %}<a href="{{ post.url }}" tabindex="-1" aria-hidden="true">{{ post.image }}</a>{% endif %}
  {% if post.show_meta %}{% include '@StarterTheme/partials/post-meta.html.twig' %}{% endif %}
  <h2><a href="{{ post.url }}">{{ post.title }}</a></h2>
  <p>{{ post.excerpt }}</p>
  <a class="text-link" href="{{ post.url }}">{{ __('Beitrag lesen') }}<span class="screen-reader-text">: {{ post.title }}</span><span aria-hidden="true">↗</span></a>
</article>
